# ── Connexion MySQL ──────────────────────────────────────────────
# L'application nécessite un serveur MySQL (par exemple mysql workbensh).
# Créez d'abord une base de données 
# puis importez le schéma database.sql.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── Sécurité ──────────────────────────────────────────────────────
# ⚠️ OBLIGATOIRE : Générez une clé unique AVEC la commande suivante :
#   python -c "import secrets; print(secrets.token_hex(64))"
# Puis collez la valeur ci-dessous.
# Toute valeur générique (CHANGE_THIS, EXAMPLE, PLACEHOLDER, etc.)
# ou toute chaîne de moins de 16 caractères refusera le démarrage.
SECRET_KEY=

# ── JWT (jetons d'authentification) ──────────────────────────────
# Durée de validité d'une session connectée, en heures.
# Après ce délai, l'utilisateur devra se reconnecter.
JWT_ACCESS_TOKEN_EXPIRES_HOURS=9

FLASK_DEBUG=false

RATELIMIT_ENABLED=true

FRONTEND_URL=http://localhost:5174
