# ============================================================
# .gitignore — Application web administrative
# Python + Flask + React + Vite + MySQL
# ============================================================

# ── Fichiers d'environnement (SECRETS — NE JAMAIS COMMITTER) ─
.env
.env.*
!.env.example

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.hypothesis/

# ── Environnements virtuels Python ───────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── Node.js / npm / pnpm ─────────────────────────────────────
node_modules/
.pnp
.pnp.js
package-lock.json

# ── Vite / React build ───────────────────────────────────────
Front-end/dist/
Front-end/.vite/
Front-end/build/

# ── Uploads utilisateurs (documents confidentiels) ───────────
back-end/uploads/
back-end/exports/

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Base de données ──────────────────────────────────────────
*.sql.bak
*.dump
*.sqlite
*.sqlite3
*.db

# ── Sauvegardes (BACKUPS) ───────────────────────────────────
backups/

# ── IDE / Éditeurs ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.DS_Store
Thumbs.db
desktop.ini

# ── Certificats et clés ──────────────────────────────────────
*.pem
*.key
*.crt
*.p12
*.pfx

# ── Docker ───────────────────────────────────────────────────
.dockerignore
docker-compose.override.yml

# ── Coverage / Tests ─────────────────────────────────────────
.coverage
coverage/
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# ── Fichiers temporaires système ─────────────────────────────
*.tmp
*.bak
*.swp
~$*
